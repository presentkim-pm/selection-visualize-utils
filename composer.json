{
  "name": "presentkim/selection-visualize-utils",
  "description": "Show block selections (structure block bounding boxes) and fake block previews to players on axolotl-pm/PocketMine-MP",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "pocketmine/pocketmine-mp": "^5.0"
  },
  "require-dev": {
    "axolotl-pm/pocketmine-mp": "^5.51",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "kim\\present\\utils\\selectionvisualize\\": "src/kim/present/utils/selectionvisualize/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "kim\\present\\utils\\selectionvisualize\\tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
